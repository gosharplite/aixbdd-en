#!/bin/sh
# aixbdd-en-managed-hook
#
# A STUB, installed into .git/hooks/pre-commit by `make install-hooks` and removed by
# `make uninstall-hooks`. It is deliberately a real file rather than a symlink into the
# worktree: `scripts/hooks/pre-commit` does not exist on every branch, and a dangling
# symlink makes git treat the hook as absent — so the gate would vanish silently the
# moment you switched to a branch that predates it.
#
# This stub always exists, and it FAILS CLOSED when the real script is missing, because
# silent ungating is the thing the gate exists to prevent.
#
# The marker line above identifies this file as ours, so uninstall can remove only what
# install created.

set -u

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "pre-commit: not inside a git worktree; cannot locate the gate." >&2
    exit 1
}

target="$root/scripts/hooks/pre-commit"

if [ ! -x "$target" ]; then
    cat >&2 <<EOF
pre-commit: THE GATE DID NOT RUN — this commit is ungated.

  expected: $target
  missing or not executable, most likely because the current branch predates it.

Rerun \`make install-hooks\` on a branch that carries it, or commit with
\`git commit --no-verify\` to skip the gate deliberately.
EOF
    exit 1
fi

exec "$target" "$@"
